{
	"name": "@bitbeater/ecma-utils",
	"version": "2.12.0",
	"type": "module",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"sideEffects": false,
	"exports": {
		".": {
			"default": "./dist/index.js"
		},
		"./collection": {
			"default": "./dist/collection/collection.js"
		},
		"./bytes": {
			"default": "./dist/bytes.js"
		},
		"./http": {
			"default": "./dist/net/http/http.js"
		},
		"./utils": {
			"default": "./dist/utils/utils.js"
		},
		"./time": {
			"default": "./dist/time/time.js"
		},
		"./*": {
			"default": "./dist/*.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc",
		"genDocs": "npx typedoc --options typedoc.json",
		"prettify": "prettier --config ./.prettierrc.json --write \"src/**/*.ts\"",
		"test": "tsc && node --import tsx --test  ./tests/{**/*,*}.test.ts",
		"tag": "node scripts/make_tag.ts"
	},
	"author": "",
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitBeater/ecma-utils.git"
	},
	"bugs": {
		"url": "https://github.com/bitBeater/ecma-utils/issues"
	},
	"homepage": "https://github.com/bitBeater/ecma-utils#readme",
	"description": "",
	"typesVersions": {
		"*": {
			"*": [
				"dist/*",
				"dist/*/index.d.ts"
			]
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@types/node": "^24.12.4",
		"prettier": "^3.7.4",
		"ts-node": "^10.9.1",
		"tsx": "^4.21.0",
		"typedoc": "^0.28.11",
		"typescript": "^5.9.2"
	}
}
